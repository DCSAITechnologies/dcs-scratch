# `vite build --mode core`: console in API mode against Connector OS core's real hermetic
# /v1 reference server (devex/api-server), served same-origin: `npm run preview:core`
# proxies /v1 from :4330 to the core server on :4020. Hermetic test credentials only —
# honoured in development/mock/core builds, never in production (gate C9 checks dist).
VITE_COS_API_URL=http://127.0.0.1:4330
VITE_COS_DEV_TOKENS=operator=coso_hermetic_operator_0000000001,approver=coso_hermetic_approver_0000000001,viewer=coso_hermetic_viewer_00000000001
