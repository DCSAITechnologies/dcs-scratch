# Public build-time configuration (compiled into the browser bundle — never put secrets here).

# Console data source. Unset → DEMO mode (fixture data under a DEMO / NON-PRODUCTION banner).
# Set → API mode: all console reads/writes go to this Connector OS API (no fixture fallback).
# VITE_COS_API_URL=https://api.staging.example.com

# Identity provider (OIDC, authorization code + PKCE). Required in API mode outside dev/mock.
# VITE_OIDC_ISSUER=https://your-tenant.example-idp.com/
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_SCOPE=openid profile email
# VITE_OIDC_AUDIENCE=

# Contact / request-access form. Unset → the form shows "not open yet" and submits nothing.
# VITE_CONTACT_ENDPOINT=https://forms.example.com/connector-os
# VITE_TURNSTILE_SITE_KEY=
