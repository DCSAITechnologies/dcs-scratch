# `vite build --mode mock` / `vite --mode mock`: console in API mode against the
# local mock server (npm run mock:api). Mock bearer tokens are honoured only in
# development/mock builds (see src/lib/api/config.ts) — never in production.
VITE_COS_API_URL=http://127.0.0.1:4010
VITE_COS_DEV_TOKENS=operator=coso_hermetic_operator_0000000001,approver=coso_hermetic_approver_0000000001,viewer=coso_hermetic_viewer_00000000001
VITE_CONTACT_ENDPOINT=http://127.0.0.1:4010/forms/contact
