{
  "name": "connector-os-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prerender": "python3 scripts/prerender.py",
    "gates": "python3 scripts/sync-catalogue.py --check && python3 scripts/build-inventory.py --check && python3 scripts/validate-catalogue.py && python3 scripts/test-validate-catalogue.py && python3 scripts/check-stale-counts.py && python3 scripts/dashboard-snapshot.py && python3 scripts/status-snapshot.py && python3 scripts/test-legacy-routes.py",
    "smoke": "python3 scripts/route-smoke.py",
    "test:e2e": "playwright test",
    "reconcile": "python3 scripts/reconcile-catalogue.py",
    "verify": "npm run lint && npm run test:unit && npm run build && npm run prerender && npm run gates && npm run smoke && npm run build:mock && npm run test:e2e",
    "mock:api": "node scripts/mock-api.mjs",
    "dev:mock": "vite --mode mock",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "api:types": "openapi-typescript public/devportal/01_openapi/connector-os-v1.yaml -o src/lib/api/schema.gen.ts",
    "test:unit": "vitest run",
    "sync:catalogue": "python3 scripts/sync-catalogue.py && python3 scripts/build-inventory.py",
    "build:core": "vite build --mode core --outDir dist-core",
    "core:assemble": "bash scripts/assemble-core.sh",
    "core:api": "node \"${COS_CORE_TREE:-.core/tree}/devex/api-server/bin/serve.mjs\" --port 4020",
    "preview:core": "COS_CORE_PROXY=http://127.0.0.1:4020 vite preview --outDir dist-core --port 4330 --strictPort --host 127.0.0.1",
    "logos": "node scripts/build-logos.mjs && npm run sync:catalogue",
    "build:cloudflare": "vite build && DEPLOY_HOST=cloudflare python3 scripts/prerender.py",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@iconify-json/logos": "^1.2.15",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "simple-icons": "^16.33.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.7"
  }
}
